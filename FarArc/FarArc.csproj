<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType Condition="'$(Configuration)'=='Debug'">Exe</OutputType>
        <OutputType Condition="'$(Configuration)'!='Debug'">WinExe</OutputType>
        <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>True</UseWindowsForms>
        <RootNamespace>FarArc</RootNamespace>
        <AssemblyName>FarArc</AssemblyName>
        <Configurations>Debug;Release</Configurations>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

        <ApplicationIcon Condition="$(Configuration.Contains('Debug'))">LOGO_D.ico</ApplicationIcon>
        <ApplicationIcon Condition="!$(Configuration.Contains('Debug'))">LOGO.ico</ApplicationIcon>


        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

        <DebugType>embedded</DebugType>
        <Platforms>AnyCPU</Platforms>
        <PlatformTarget>AnyCPU</PlatformTarget>

        <LangVersion>latest</LangVersion>
        <StartupObject>FarArc.Program</StartupObject>
        <GenerateDocumentationFile>False</GenerateDocumentationFile>
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <RunPostBuildEvent>Always</RunPostBuildEvent>
        <XamlDebuggingInformation>True</XamlDebuggingInformation>

        <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
        <!-- 20241030 fix https://github.com/dotnet/sdk/issues/43680 -->
    </PropertyGroup>
    <PropertyGroup>
        <!-- Keep native SQLite interop selection explicit for the x64 ZIP build. -->
        <ContentSQLiteInteropFiles>true</ContentSQLiteInteropFiles>
        <CopySQLiteInteropFiles>false</CopySQLiteInteropFiles>
        <CleanSQLiteInteropFiles>false</CleanSQLiteInteropFiles>
        <CollectSQLiteInteropFiles>false</CollectSQLiteInteropFiles>
        <SignAssembly>False</SignAssembly>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <Version>0.1.0</Version>
        <InformationalVersion>0.1.0</InformationalVersion>
        <Authors>Yafeiml</Authors>
        <Product>FarArc</Product>
        <Description>FarArc is a unified Windows remote connection workspace for RDP, SSH, VNC, SFTP, and more.</Description>
        <RepositoryUrl>https://github.com/Yafeiml/FarArc</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright (c) 2026 Yafeiml and contributors</Copyright>
        <FarArcEncryptionKeyFile Condition="'$(FarArcEncryptionKeyFile)' == ''">C:\FarArc_Secret\EncryptionKey.txt</FarArcEncryptionKeyFile>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants>TRACE;</DefineConstants>
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
        <Optimize>True</Optimize>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('Debug'))">
        <DefineConstants>TRACE;DEBUG;DEV;</DefineConstants>
        <Optimize>False</Optimize>
    </PropertyGroup>

